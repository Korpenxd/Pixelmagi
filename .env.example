# Public site address used for canonical URLs, sitemap and social previews.
NEXT_PUBLIC_SITE_URL=https://pixelmagi.se

# Supabase project settings.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin login. Use long, unique random values in production.
ADMIN_PASSWORD=
ADMIN_SESSION_TOKEN=

# Optional form endpoint, for example a Formspree endpoint.
# When empty, the contact form opens the visitor's email application instead.
NEXT_PUBLIC_CONTACT_FORM_ENDPOINT=
